#!/usr/bin/env bash
set -euo pipefail

PORT="${1:-8000}"
HOST="${ESC_HOST:-127.0.0.1}"
KEEP_AWAKE="${ESC_KEEP_AWAKE:-0}"
PROJECT_DIR="/Users/chide/Desktop/ESC/py"
LOG_DIR="/Users/chide/Desktop/ESC/.logs"
PID_FILE="${LOG_DIR}/esc-dashboard-${PORT}.pid"
LOG_FILE="${LOG_DIR}/esc-dashboard-${PORT}.log"

mkdir -p "${LOG_DIR}"

existing_pids="$(lsof -tiTCP:"${PORT}" -sTCP:LISTEN 2>/dev/null || true)"
if [[ -n "${existing_pids}" ]]; then
  echo "Stopping existing listener(s) on port ${PORT}: ${existing_pids}"
  kill ${existing_pids} 2>/dev/null || true
  sleep 0.5

  remaining_pids="$(lsof -tiTCP:"${PORT}" -sTCP:LISTEN 2>/dev/null || true)"
  if [[ -n "${remaining_pids}" ]]; then
    echo "Force-stopping stubborn listener(s) on port ${PORT}: ${remaining_pids}"
    kill -9 ${remaining_pids} 2>/dev/null || true
  fi
fi

cd "${PROJECT_DIR}"
server_command=(python3 visualize_world.py --host "${HOST}" --port "${PORT}")
if [[ "${KEEP_AWAKE}" == "1" || "${KEEP_AWAKE}" == "true" ]]; then
  if command -v caffeinate >/dev/null 2>&1; then
    server_command=(caffeinate -dimsu "${server_command[@]}")
  else
    echo "ESC_KEEP_AWAKE was set, but caffeinate was not found. Starting normally."
  fi
fi

nohup "${server_command[@]}" > "${LOG_FILE}" 2>&1 &
server_pid="$!"
echo "${server_pid}" > "${PID_FILE}"

sleep 0.7
if ! kill -0 "${server_pid}" 2>/dev/null; then
  echo "ESC dashboard failed to start. Last log lines:"
  tail -n 30 "${LOG_FILE}" || true
  exit 1
fi

echo "ESC dashboard started."
echo "URL: http://${HOST}:${PORT}/"
echo "PID: ${server_pid}"
echo "Log: ${LOG_FILE}"
if [[ "${KEEP_AWAKE}" == "1" || "${KEEP_AWAKE}" == "true" ]]; then
  echo "Keep-awake mode: on"
fi
